<!DOCTYPE html>
<html lang="ko">
<bead>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="../css/product_list.css?ver=251030">
    <link rel="stylesheet" href="../css/product_list.css?ver=251030">
</bead>
<body>
<div class="product_list">
    <div class="product">
        <div class="pr_images">
            <img src="../images/sample/thumbnail_sample.gif"/>
        </div>
        <div class="product_contents">
            <div class="pr_con_01">
                <div class="brand_name">
                    
                </div>
                <div class="product_name">
                    
                </div>
            </div>
            <div class="pr_con_02">
                <div class="pr_price">
                    <div class="price_text"></div>
                    <div class="price_number"></div>
                </div>
                <div class="pr_size">
                    <div class="size_text"></div>
                    <div class="size_btn"></div>
                </div>
                <div class="pr_quantity">
                    <div class="minus_btn">-</div>
                    <div class="quantity_number">00</div>
                    <div class="plus_btn">+</div>
                    <div class="pr_shop_cart">
                        <img src="../images/icon/addcart_icon.png"/>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</body>
</html>