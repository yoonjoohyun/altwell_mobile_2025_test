<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="euc-kr">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>상품 디테일 - 앨트웰 모바일 쇼핑몰</title>
    <link rel="stylesheet" href="/2025/css/index.css?ver=044">
    <link rel="stylesheet" href="/2025/css/main.css?ver=044">
    <link rel="stylesheet" href="/2025/css/payment.css?ver=044">
</head>
<body>
<div class="wrap">
    <!--#include virtual="/2025/components/top_navi.asp" -->
    <div class="detail_main_contents">
        <div class="category_navi">
            <div class="back_btn"></div>
            <p>주문 정보</p>
        </div>
        <div class="pr_buy_info">
            <div class="buy_info_con_01">
                <div class="pr_images">
                    <img src="/2025/images/sample/thumbnail_sample_03.gif"/>
                </div>
                <div class="pr_name">
                    <div class="category_small">
                        코어벨
                    </div>
                    <div class="product_name">
                        누벨마리 오픈버스트 바디슈츠 (그린)
                    </div>
                    <div class="info_conbox">
                        <div class="con_left">회원가</div>
                        <div class="con_right">500,000원</div>
                    </div>
                    <div class="info_conbox">
                        <div class="con_left">EP</div>
                        <div class="con_right">400,000</div>
                    </div>
                    <div class="info_conbox">
                        <div class="con_left">수량</div>
                        <div class="con_right">2개</div>
                    </div>
                    <div class="info_congap"></div>
                    <div class="info_conbox">
                        <div class="con_left">총 금액</div>
                        <div class="con_right">1,000,000원</div>
                    </div>
                    <div class="info_conbox">
                        <div class="con_left">총 EP</div>
                        <div class="con_right">800,000</div>
                    </div>
                </div>
            </div>
            <div class="buy_info_con_02">
            </div>
            <div class="del_info_con">
                <div class="del_line">
                    <div class="del_info">인수자</div>
                    <input class="del_info_t" type="text">
                </div>
                <div class="del_line">
                    <div class="del_info">휴대 전화</div>
                    <input class="del_info_phone" type="text">
                    <input class="del_info_phone" type="text">
                    <input class="del_info_phone" type="text">
                </div>
                <div class="del_line">
                    <div class="del_info">주소</div>
                    <input class="del_info_t" type="text">
                </div>
                <div class="del_line">
                    <div class="del_info">우편 번호</div>
                    <input class="del_info_post" type="text">
                    <div class="post_search_btn">검색</div>
                </div>
            </div>
        </div>
        <div class="buy_navi">
            <div class="buy_navi_btn add_cart">
                <p>취소</p>
            </div>
            <div class="buy_navi_btn buy_now">
                <p>구매</p>
            </div>
        </div>
    </div>
</div>
<script src="/2025/js/script.js?ver=040"></script>
</body>
</html>